{
  "name": "homelab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "node scripts/native.mjs tauri",
    "test": "node scripts/native.mjs cargo test --manifest-path src-tauri/Cargo.toml",
    "test:keychain": "node scripts/native.mjs cargo test --manifest-path src-tauri/Cargo.toml keychain_roundtrip -- --ignored",
    "sandbox:build": "node scripts/sandbox-fixtures.mjs && node scripts/native.mjs tauri build --debug --features sandbox-check --config src-tauri/tauri.sandbox.conf.json --bundles app"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
